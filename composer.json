{
    "name": "bic/business-intelligence-commerce",
    "description": "Business Intelligence Commerce (BIC)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "schema:check": "@php bin/schema.php check",
        "schema:build": "@php bin/schema.php build",
        "migrate": "@php bin/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
